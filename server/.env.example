# Copy to .env and fill in. config/env.js refuses to boot if any of these are
# missing or weak, which is deliberate — a server that starts with a default
# secret is worse than one that doesn't start.

NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://user:password@localhost:5432/studyplan?schema=public"

# Must be long and random. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated exact origins. Never "*" once auth is live.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
